{{!--
	Community-flavoured variant of Streams/templates/invited/complete.

	This is now OPT-IN. Communities no longer overrides
	Streams/types/*/invited/dialog/templateName -- doing that for every stream
	type is what replaced the accept form with the onboarding tool and left
	logged-in users unable to accept anything. Point a specific type at this
	template if you want the extra chrome, e.g.

		"Streams": { "types": { "Calendars/event": {
			"invited": { "dialog": {
				"templateName": "Communities/invited/complete"
			} }
		} } }

	The only thing this adds over the Streams template is the event timestamp.
	Everything else -- inviting user, stream preview, discount, roles -- comes
	from {{{explanation}}} and must not be repeated here.
--}}
<div id="Streams_complete_overlay" class="Users_login_dialog Communities_invited_complete">
	<div class="Q_title_slot">
		<h2 class="Users_dialog_title Q_dialog_title">{{interpolate invite.complete.WelcomeToCommunity communityName=communityName}}</h2>
	</div>
	<div class="Q_dialog_slot Q_dialog_content Q_big_prompt">
		{{{explanation}}}
		{{#if (call "stream.get" "timestamp")}}
		<div class="Streams_complete_when">
			<div class="Q_tool Q_timestamp_tool"
				data-q-timestamp="{ &quot;time&quot;: {{call "stream.get" "timestamp"}} }">
			</div>
		</div>
		{{/if}}
		<form method="post" action="{{action}}" data-form-type="complete">
			<div class="Streams_login_appear"></div>
			{{#if nameIsMissing}}
			<table>
				<tr class="Users_register_form">
					<td class="Streams_login_picture"><img src="{{icon}}/50.png" alt=""></td>
					<td class="Streams_login_fullname_block">
						<label for="Streams_login_fullname">{{prompt}}</label>
						<input id="Streams_login_fullname" name="fullName" type="text" class="text" />
					</td>
				</tr>
			</table>
			{{/if}}
			<input type="hidden" name="token" value="{{token}}"/>
			<input type="hidden" name="Q.Streams.acceptInvite" value="1">
			<input type="hidden" name="Q.method" value="get"/>
			<div class="Streams_login_get_started">
				<button type="submit" class="Q_button Q_main_button Streams_invited_accept Streams_login_start">{{acceptButton}}</button>
				{{#unless nameIsMissing}}
				<button type="button" class="Q_button Streams_invited_decline">{{declineButton}}</button>
				{{/unless}}
			</div>
		</form>
	</div>
</div>
